# Runtime
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgresql://satal:satal@localhost:5432/satal
# Optional: enables PostgreSQL integration tests against an isolated test database.
TEST_DATABASE_URL=

# Authentication (generate a unique secret outside source control)
AUTH_SECRET=replace-with-at-least-32-random-characters

# External adapters fail closed until production credentials are configured.
SMS_PROVIDER=disabled
EMAIL_PROVIDER=disabled
OBJECT_STORAGE_PROVIDER=local
# Continuous media worker tuning. Safe defaults suit local development and a small MVP worker.
MEDIA_WORKER_POLL_MS=1000
MEDIA_WORKER_BATCH_SIZE=10
MEDIA_WORKER_HEARTBEAT_MS=30000
MEDIA_WORKER_MAINTENANCE_MS=300000
SEARCH_PROVIDER=postgres
# Required only when SEARCH_PROVIDER=typesense.
TYPESENSE_URL=
TYPESENSE_API_KEY=
